# Copiá este archivo a .env.local (no se versiona) y completá los valores.
# Nunca pegues estos valores en el chat, en un issue ni en el repo.

# Conexión de administrador de cada proyecto de Supabase, la del "Session pooler"
# (botón Connect del proyecto): postgresql://postgres.<ref>:<contraseña>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# La usa solo `npm run setup:db -w api -- --env <entorno>` para crear la conexión del Worker.
SUPABASE_ADMIN_DB_URL_PREVIEW=
SUPABASE_ADMIN_DB_URL_PRODUCTION=
