# Copiá este archivo a .env.local (no se versiona) y completá los valores.
# Nunca pegues estos valores en el chat, en un issue ni en el repo.

# Conexión de administrador del proyecto de Supabase (producción, el único en la nube), la del
# "Session pooler" (botón Connect, puerto 5432):
#   postgresql://postgres.<ref>:<contraseña>@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
# La usan solo `npm run db:push` (migraciones) y `npm run setup:db -w api` (conexión del Worker),
# desde tu máquina. No va a GitHub. Para probar en local (`npm run dev:local`) no hace falta.
SUPABASE_ADMIN_DB_URL=

# Login de adultos en la app (públicos: terminan dentro de la app). Del panel de Supabase,
# Project Settings → API Keys: la URL del proyecto y la clave *publishable* (sb_publishable_…),
# no la anon legada. Los usa `npm run build` para publicar a mano; el CI los toma de las
# variables del environment production.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
