// Un solo Worker sirve la app (assets estáticos de app/dist) y la API en /api/*: mismo dominio,
// sin CORS (arquitectura §1). Los secretos no van acá: la conexión a la base está en
// Hyperdrive (ver docs/puesta-en-marcha.md).
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "gatita-gramatica",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-21",
  // postgres.js usa sockets TCP de node.
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../app/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // Id de `wrangler hyperdrive create` (no es secreto).
      "id": "00000000000000000000000000000000",
      // Base local de `supabase start` (credenciales por defecto de desarrollo).
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:54322/postgres",
    },
  ],
  "vars": {
    // URL pública del proyecto de Supabase de desarrollo.
    "SUPABASE_URL": "http://127.0.0.1:54321",
  },
  "ratelimits": [
    {
      "name": "ROUNDS_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 },
    },
    // Ingresos al aula por IP (además del conteo en la base).
    { "name": "JOIN_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
    // Reportes de error de la app por IP.
    { "name": "ERRORS_LIMITER", "namespace_id": "1005", "simple": { "limit": 30, "period": 60 } },
  ],
  "triggers": {
    // Una vez por día: evita que Supabase pause el proyecto del plan gratis.
    "crons": ["0 12 * * *"],
  },
  "observability": { "enabled": true },
  // Arriba: desarrollo local (`wrangler dev` contra `supabase start`). Abajo: el único proyecto
  // de Supabase en la nube, el de producción (`npm run setup:db -w api` completa id y URL).
  "env": {
    "production": {
      "name": "gatita-gramatica",
      "vars": { "SUPABASE_URL": "https://yepljlazehfasnpxjgbb.supabase.co" },
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "cd00b8c80b224b13b8de23dc20bc66cf" }],
      "ratelimits": [
        {
          "name": "ROUNDS_LIMITER",
          "namespace_id": "1003",
          "simple": { "limit": 60, "period": 60 },
        },
        {
          "name": "JOIN_LIMITER",
          "namespace_id": "1004",
          "simple": { "limit": 10, "period": 60 },
        },
        {
          "name": "ERRORS_LIMITER",
          "namespace_id": "1006",
          "simple": { "limit": 30, "period": 60 },
        },
      ],
      "triggers": { "crons": ["0 12 * * *"] },
    },
  },
}
